# ==============================================================================
# SkillMarket Environment Configuration (.env)
# ==============================================================================

# Session & Security Secret
SECRET_KEY=skillmarket-production-secret-key-replace-in-production

# Database Connection (SQLite default)
DATABASE_URL=sqlite:///skillmarket.db

# ------------------------------------------------------------------------------
# Gmail SMTP Configuration for Real Email Delivery
# ------------------------------------------------------------------------------
# 1. Enable 2-Step Verification in your Google Account:
#    https://myaccount.google.com/signinoptions/two-step-verification
# 2. Create an App Password for 'SkillMarket' (Mail / Other name):
#    https://myaccount.google.com/apppasswords
# 3. Paste your full Gmail address and the 16-character App Password below:

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
MAIL_DEFAULT_SENDER="SkillMarket Team <your-email@gmail.com>"

# ------------------------------------------------------------------------------
# OTP Security Thresholds
# ------------------------------------------------------------------------------
OTP_EXPIRATION_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------------------
# AI Career Assistant Configuration (Optional)
# ------------------------------------------------------------------------------
# Provide an API key for Google Gemini / OpenAI-compatible endpoint.
# If omitted or empty, SkillMarket automatically falls back to its built-in
# local Career Intelligence Rule Engine so the assistant works offline.
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
MAX_RESUME_SIZE_MB=5
